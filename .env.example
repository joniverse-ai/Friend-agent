# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소와 배포에 올라가지 않는다.
# LLM_PROVIDER: openai, gemini, claude, fake 중 하나. fake 는 키 없이 가짜 응답을 돌려준다.
LLM_PROVIDER=fake
LLM_API_KEY=
# 비워 두면 제공자별 기본 모델을 쓴다
LLM_MODEL=
ENV=local

# 저장소와 로그인. 처음에는 memory, none 으로 둔다. Supabase 연결은 docs/supabase.md
STORAGE=memory
AUTH=none
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GOOGLE_LOGIN=false

# Langfuse 트레이스. 키 두 개가 다 있을 때만 켜진다. 비워 두면 트레이스를 보내지 않는다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# 토스페이먼츠 결제위젯. 두 키가 다 있을 때만 크레딧 결제가 켜진다.
# 결제위젯 연동 문서의 문서용 테스트 키(test_gck_…, test_gsk_…)를 한 세트로 넣는다. test_ck_ 키로는 위젯이 뜨지 않는다.
# 배포한 서비스에서는 시크릿 키를 Secret Manager 에 두고 이름으로 연결한다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
